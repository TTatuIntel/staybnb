# SQLite for local development. For production use Postgres, e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/staybnb?schema=public"
# and change `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Secret used to sign JWTs. Change this in production.
JWT_SECRET="change-me-to-a-long-random-string"

# Port the API listens on
PORT=4000

# Comma-separated list of origins allowed to call the API with credentials.
# Add your mobile dev origin (e.g. exp://...) later if needed; native apps
# do not send an Origin header so they are allowed by default.
CORS_ORIGINS="http://localhost:3000"

# Set to "true" when the API is served over HTTPS so the auth cookie is Secure.
COOKIE_SECURE=false
